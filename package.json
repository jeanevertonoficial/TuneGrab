{
  "name": "tunegrab",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Baixe músicas, playlists e vídeos do YouTube, Spotify e Deezer, salve no pendrive e ouça com letra.",
  "author": "Jean Everton",
  "scripts": {
    "postinstall": "node scripts/setup-ytdlp.mjs && nuxt prepare",
    "setup": "node scripts/setup-ytdlp.mjs --force",
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "icons": "node scripts/make-icons.mjs",
    "desktop": "nuxt build && electron electron",
    "release": "node scripts/publish-release.mjs",
    "dist": "nuxt build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "archiver": "^8.0.0",
    "ffmpeg-static": "^5.3.0",
    "music-metadata": "^12.3.3",
    "node-id3": "^0.2.9",
    "nuxt": "^4.6.3",
    "vue": "latest",
    "vue-router": "latest"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.jeaneverton.tunegrab",
    "productName": "TuneGrab",
    "copyright": "Jean Everton",
    "directories": {
      "app": "electron",
      "output": "release"
    },
    "asar": true,
    "extraResources": [
      {
        "from": ".output",
        "to": "server"
      },
      {
        "from": "bin/yt-dlp",
        "to": "bin/yt-dlp"
      },
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "public/icons/icon-512.png",
        "to": "icon.png"
      },
      {
        "from": "public/icons/favicon-32.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icons/icon-512.png",
      "executableName": "TuneGrab"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TuneGrab",
      "runAfterFinish": true,
      "uninstallDisplayName": "TuneGrab",
      "artifactName": "TuneGrab-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json",
      "!**/node_modules/**"
    ],
    "npmRebuild": false,
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ]
  }
}
